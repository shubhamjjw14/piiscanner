# Copy to .env and fill in.  .env is gitignored; never commit real values.
#
#   cp .env.example .env && $EDITOR .env
#   set -a && . ./.env && set +a
#   scripts/scan_local.sh

# -- the database to scan ---------------------------------------------------
PIISCANNER_DB=your_database_name
PIISCANNER_HOST=127.0.0.1
PIISCANNER_PORT=3306

# -- the read-only account the scanner will use ----------------------------
# Created by scripts/scan_local.sh with SELECT and nothing else.
PIISCANNER_RO_USER=piiscanner_ro
PIISCANNER_RO_PASS=change_me

# -- admin access, used ONLY to create that account ------------------------
# Either point at a docker container...
PIISCANNER_CONTAINER=
PIISCANNER_ADMIN_USER=
PIISCANNER_ADMIN_PASS=
# ...or give an admin DSN for a server you reach directly.
PIISCANNER_ADMIN_DSN=

# -- optional --------------------------------------------------------------
PIISCANNER_SAMPLE=500
PIISCANNER_OUT_DIR=audit/raw
